# Copy to `.env.local` and fill in from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
#
# The web API key is NOT a secret. It is shipped in the client bundle by design
# and is safe to commit. There are no other secrets in v1.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase console -> App Hosting -> your backend. Leave empty locally.
NEXT_PUBLIC_FIREBASE_APPHOSTING_BACKEND_ID=

# Firebase console -> App Check -> reCAPTCHA Enterprise -> site key.
# Leave empty locally; the emulator accepts App Check tokens without one.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# true = talk to the local emulator suite. Never set this true in App Hosting.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
